---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Awake - Keep your Mac awake"
	description="100% Free, zero-dependency, open-source native macOS keep-awake utility. Timed sessions, closed-lid clamshell mode, battery safeguards, app triggers, and CLI automation right from your menu bar."
>
	<div hidden><!--$--><!--/$--></div>
	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-black">Skip to content</a>

	<div class="landing-page">
		<header class="site-nav">
			<nav aria-label="Main navigation" class="site-nav-inner">
				<a aria-label="Awake home" class="site-brand" href="/">
					<div class="flex items-center gap-2.5">
						<img
							alt="Awake icon"
							loading="eager"
							width="36"
							height="36"
							decoding="async"
							class="app-icon-squircle size-8 shrink-0 object-contain"
							src="/awake-icon.png"
						/>
						<span class="font-bold tracking-tight text-xl text-foreground select-none">Awake</span>
					</div>
				</a>

				<ul class="desktop-nav-links">
					<li><a href="#demo">Demo</a></li>
					<li><a href="#features">Features</a></li>
					<li><a href="#clamshell">Closed-Lid</a></li>
					<li><a href="#cli">CLI & Terminal</a></li>
					<li><a href="#open-source">Open Source</a></li>
					<li><a href="#faq">FAQ</a></li>
				</ul>

				<div class="nav-actions">
					<button
						type="button"
						id="theme-toggle"
						class="appearance-toggle"
						aria-label="Toggle theme appearance"
						title="Toggle theme appearance"
					>
						<span class="appearance-icon" aria-hidden="true">
							<span class="sun-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun">
									<circle cx="12" cy="12" r="4"></circle>
									<path d="M12 2v2"></path>
									<path d="M12 20v2"></path>
									<path d="m4.93 4.93 1.41 1.41"></path>
									<path d="m17.66 17.66 1.41 1.41"></path>
									<path d="M2 12h2"></path>
									<path d="M20 12h2"></path>
									<path d="m6.34 17.66-1.41 1.41"></path>
									<path d="m19.07 4.93-1.41 1.41"></path>
								</svg>
							</span>
							<span class="moon-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon">
									<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
								</svg>
							</span>
						</span>
					</button>

					<a
						class="apple-button apple-button-secondary nav-github"
						href="https://github.com/pawanbhayde/awake"
						target="_blank"
						rel="noopener noreferrer"
					>
						<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
							<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
						</svg>
						GitHub
					</a>

					<a
						class="apple-button nav-desktop-buy"
						href="/Awake.dmg"
						download=""
					>
						<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" focusable="false" aria-hidden="true">
							<path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"></path>
						</svg>
						Download Free
					</a>

					<a
						class="apple-button nav-buy"
						href="/Awake.dmg"
						download=""
					>
						Download Free
					</a>

					<button
						type="button"
						id="mobile-toggle"
						class="mobile-menu-toggle"
						aria-label="Open menu"
						aria-expanded="false"
						aria-controls="mobile-navigation"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu">
							<path d="M4 5h16"></path>
							<path d="M4 12h16"></path>
							<path d="M4 19h16"></path>
						</svg>
					</button>
				</div>
			</nav>

			<!-- Mobile navigation panel -->
			<div id="mobile-navigation" class="mobile-nav-panel" style="display: none;">
				<a href="#demo" class="mobile-nav-link">Demo</a>
				<a href="#features" class="mobile-nav-link">Features</a>
				<a href="#clamshell" class="mobile-nav-link">Closed-Lid Mode</a>
				<a href="#cli" class="mobile-nav-link">CLI & Terminal</a>
				<a href="#open-source" class="mobile-nav-link">Open Source</a>
				<a href="#faq" class="mobile-nav-link">FAQ</a>
				<a href="https://github.com/pawanbhayde/awake" target="_blank" rel="noopener noreferrer" class="mobile-nav-link">Star on GitHub</a>
			</div>
		</header>

		<main id="main-content">
			<!-- Hero Section -->
			<section class="product-hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<h1 id="hero-title">
						Your Mac.<br />
						<span>Wide Awake.</span>
					</h1>
					<p>
						Keep your Mac awake while your long builds, machine learning models, and AI agents run, even with the lid closed.
					</p>
					<div class="hero-actions">
						<a
							class="apple-button"
							href="/Awake.dmg"
							download=""
						>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" focusable="false" aria-hidden="true">
								<path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"></path>
							</svg>
							Download for Mac
						</a>
						<a
							class="apple-button apple-button-secondary"
							href="https://github.com/pawanbhayde/awake"
							target="_blank"
							rel="noopener noreferrer"
						>
							View on GitHub
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right">
								<path d="m9 18 6-6-6-6"></path>
							</svg>
						</a>
					</div>
					<p class="hero-license-note">100% Free &amp; Open Source · Zero dependencies · Zero telemetry · Universal Binary</p>
				</div>

				<!-- Hero Product Demo Showcase -->
				<figure id="demo" class="hero-product-demo">
					<div class="hero-screen">
						<div class="desktop-mockup">
							<!-- macOS Menu Bar -->
							<div class="macos-menubar">
								<div class="menubar-left">
									<span class="apple-logo"></span>
									<span class="app-name">Awake</span>
									<span class="menu-item">File</span>
									<span class="menu-item">Edit</span>
									<span class="menu-item">View</span>
									<span class="menu-item">Window</span>
									<span class="menu-item">Help</span>
								</div>
								<div class="menubar-right">
									<!-- Awake Menu Bar Item -->
									<div class="awake-status-item active" id="hero-menubar-status">
										<span class="status-cup">☕️</span>
										<span class="status-pulse-dot"></span>
										<span class="status-timer-text" id="menubar-time-text">01:45:00</span>
									</div>
									<span class="menubar-icon">
										<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
									</span>
									<span class="menubar-battery">94% ⚡️</span>
									<span class="menubar-clock" id="current-clock">9:41 AM</span>
								</div>
							</div>

							<!-- Desktop Wallpaper Canvas with Awake Popover -->
							<div class="desktop-canvas">
								<div class="popover-wrapper">
									<div class="awake-popover">
										<!-- Popover Header -->
										<div class="popover-head">
											<div class="popover-title-row">
												<img src="/awake-icon.png" alt="Awake" class="popover-app-icon" />
												<div>
													<div class="popover-name">Awake</div>
													<div class="popover-version">macOS Native · v1.0.0</div>
												</div>
											</div>
											<div class="popover-badges">
												<span class="badge-status-active" id="hero-badge">ACTIVE</span>
												<button class="settings-gear-btn" title="Open Settings (⌘,)">
													<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>
												</button>
											</div>
										</div>

										<!-- Primary Active State Banner -->
										<div class="popover-state-card" id="state-card">
											<div class="state-icon-pulse">
												<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4"></path><path d="m4.93 4.93 2.83 2.83"></path><path d="M2 12h4"></path><path d="m4.93 19.07 2.83-2.83"></path><path d="M12 18v4"></path><path d="m19.07 19.07-2.83-2.83"></path><path d="M18 12h4"></path><path d="m19.07 4.93-2.83 2.83"></path></svg>
											</div>
											<div class="state-info">
												<div class="state-headline">Keep-Awake Active</div>
												<div class="state-timer" id="hero-countdown">01:45:00 remaining</div>
											</div>
											<button class="popover-toggle-btn" id="btn-toggle-session" title="Toggle keep-awake session">
												<span class="btn-toggle-knob"></span>
											</button>
										</div>

										<!-- Quick Duration Presets -->
										<div class="popover-section-label">QUICK TIMERS</div>
										<div class="preset-pill-grid">
											<button class="preset-pill" data-time="15m">15m</button>
											<button class="preset-pill" data-time="30m">30m</button>
											<button class="preset-pill" data-time="1h">1h</button>
											<button class="preset-pill active" data-time="2h">2h</button>
											<button class="preset-pill" data-time="4h">4h</button>
											<button class="preset-pill" data-time="unlimited">∞</button>
										</div>

										<!-- Feature Toggles in Popover -->
										<div class="popover-toggles">
											<div class="popover-toggle-row">
												<div class="toggle-desc">
													<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2z"></path><path d="M20.054 15.987H3.946"></path></svg>
													<div>
														<strong>Closed-Lid Mode</strong>
														<span>Ready to close lid safely</span>
													</div>
												</div>
												<span class="mac-switch"></span>
											</div>

											<div class="popover-toggle-row">
												<div class="toggle-desc">
													<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m11 7-3 5h4l-3 5"></path><path d="M14.856 6H16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.935"></path><path d="M22 14v-4"></path><path d="M5.14 18H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h2.936"></path></svg>
													<div>
														<strong>Battery Cutoff Guard</strong>
														<span>Auto-stop at 20%</span>
													</div>
												</div>
												<span class="mac-stepper">20%</span>
											</div>

											<div class="popover-toggle-row">
												<div class="toggle-desc">
													<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="12" x="3" y="4" rx="2"></rect><line x1="2" x2="22" y1="20" y2="20"></line></svg>
													<div>
														<strong>Presentation Mode</strong>
														<span>Mutes alerts &amp; keeps display lit</span>
													</div>
												</div>
												<span class="mac-switch"></span>
											</div>
										</div>

										<!-- Popover Actions Footer -->
										<div class="popover-actions-footer">
											<button class="action-sub-btn" id="btn-add-15">+15m</button>
											<button class="action-sub-btn" id="btn-pause-resume">Pause</button>
											<button class="action-sub-btn" id="btn-stop-session">Stop</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<figcaption class="demo-caption">
						<span>Your session, a single click away in the menu bar.</span>
						<span class="demo-shortcut">
							Settings <kbd>⌘</kbd> <kbd>,</kbd>
						</span>
					</figcaption>
				</figure>
			</section>

			<!-- Features Section -->
			<section id="features" aria-label="Features" class="product-features section-shell">
				<!-- Feature 1: Focus Feature Sessions -->
				<article id="sessions" class="focus-feature" aria-labelledby="sessions-title">
					<div class="feature-copy">
						<h2 id="sessions-title">
							Start the session.<br />
							<span>Walk away.</span>
						</h2>
						<p>
							Pick a timer preset or let it run indefinitely. An active glowing indicator in your macOS menu bar confirms your system won't sleep, sleep-lock, or kill background tasks.
						</p>
					</div>

					<figure class="session-stage">
						<div class="session-recording">
							<div class="feature-mock-card">
								<div class="mock-header">
									<div class="mock-pill">15m</div>
									<div class="mock-pill">30m</div>
									<div class="mock-pill">1h</div>
									<div class="mock-pill active-pill">2h Active</div>
									<div class="mock-pill">Unlimited ∞</div>
								</div>
								<div class="mock-countdown-box">
									<span class="mock-timer-digits">01:59:48</span>
									<span class="mock-timer-sub">Time remaining until display sleep allowed</span>
								</div>
								<div class="mock-footer-row">
									<span class="mock-active-dot"></span>
									<span>System Sleep Assertion: <strong>Active (IOPMAssertion)</strong></span>
								</div>
							</div>
						</div>
						<figcaption class="sr-only">Awake menu bar session controls and timer duration presets.</figcaption>
					</figure>
				</article>

				<!-- Feature Pair 1: Closed-Lid Clamshell & Battery Guard -->
				<div class="feature-pair" id="clamshell">
					<!-- Closed-Lid Mode -->
					<article id="closed-lid" class="feature-tile" aria-labelledby="closed-lid-title">
						<div class="feature-tile-copy">
							<h2 id="closed-lid-title">
								Close the lid.<br />
								<span>Keep it running.</span>
							</h2>
							<p>
								Run long compiles, dataset transfers, and LLM inferences with your MacBook lid closed, without needing an external monitor.
							</p>
						</div>

						<div class="feature-stage stage-lid" role="img" aria-label="Awake closed-lid clamshell mode panel showing Ready to close the lid">
							<div class="mac-panel" aria-hidden="true">
								<div class="mac-panel-row mac-panel-head">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-laptop">
										<path d="M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2z"></path>
										<path d="M20.054 15.987H3.946"></path>
									</svg>
									<strong>Closed-lid mode</strong>
									<span class="mac-switch"></span>
								</div>
								<ol class="mac-steps">
									<li>
										<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check">
											<path d="M20 6 9 17l-5-5"></path>
										</svg>
										Clamshell assertion active
									</li>
									<li>
										<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check">
											<path d="M20 6 9 17l-5-5"></path>
										</svg>
										Session running<span>01:59:54</span>
									</li>
								</ol>
								<div class="mac-status">
									<span class="mac-status-dot"></span>
									<div>
										<strong>Ready to close the lid</strong>
										<span>Your session is protected</span>
									</div>
								</div>
							</div>
						</div>
					</article>

					<!-- Battery & Power -->
					<article id="battery" class="feature-tile" aria-labelledby="battery-title">
						<div class="feature-tile-copy">
							<h2 id="battery-title">
								Plug in.<br />
								<span>Or don’t.</span>
							</h2>
							<p>
								Require a power adapter, or run on battery down to a cutoff threshold you set with thermal safeguards.
							</p>
						</div>

						<div class="feature-stage stage-battery" role="img" aria-label="Awake Battery and Power settings with a 20% battery cutoff">
							<div class="mac-panel" aria-hidden="true">
								<div class="mac-panel-row mac-panel-head">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-battery-charging">
										<path d="m11 7-3 5h4l-3 5"></path>
										<path d="M14.856 6H16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.935"></path>
										<path d="M22 14v-4"></path>
										<path d="M5.14 18H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h2.936"></path>
									</svg>
									<strong>Battery &amp; Power Guard</strong>
