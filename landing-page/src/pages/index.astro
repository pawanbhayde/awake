	<!-- Interactive Client-side Scripting -->
	<script is:inline>
		// Theme appearance toggling
		const toggleBtn = document.getElementById('theme-toggle');
		toggleBtn?.addEventListener('click', () => {
			const isDark = document.documentElement.classList.contains('dark');
			if (isDark) {
				document.documentElement.classList.remove('dark');
				document.documentElement.classList.add('light');
				localStorage.setItem('awake-appearance', 'light');
			} else {
				document.documentElement.classList.remove('light');
				document.documentElement.classList.add('dark');
				localStorage.setItem('awake-appearance', 'dark');
			}
		});

		// Mobile navigation drawer toggling
		const mobileToggle = document.getElementById('mobile-toggle');
		const mobileNav = document.getElementById('mobile-navigation');
		mobileToggle?.addEventListener('click', () => {
			const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
			mobileToggle.setAttribute('aria-expanded', !isExpanded);
			if (mobileNav) {
				mobileNav.style.display = isExpanded ? 'none' : 'block';
			}
		});

		// Close mobile navigation when a link is clicked
		document.querySelectorAll('.mobile-nav-link').forEach(link => {
			link.addEventListener('click', () => {
				mobileToggle?.setAttribute('aria-expanded', 'false');
				if (mobileNav) mobileNav.style.display = 'none';
			});
		});

		// Real-time clock in menu bar
		function updateClock() {
			const now = new Date();
			const clockEl = document.getElementById('current-clock');
			if (clockEl) {
				clockEl.textContent = now.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
			}
		}
		updateClock();
		setInterval(updateClock, 30000);

		// Interactive Popover Timer in Demo
		let activeSeconds = 6300; // 1h 45m
		let isSessionRunning = true;
		const countdownEl = document.getElementById('hero-countdown');
		const menubarTimeEl = document.getElementById('menubar-time-text');
		const stateCard = document.getElementById('state-card');
		const heroBadge = document.getElementById('hero-badge');
		const heroMenubarStatus = document.getElementById('hero-menubar-status');

		function formatTime(totalSec) {
			if (totalSec <= 0) return '00:00:00';
			const h = Math.floor(totalSec / 3600);
			const m = Math.floor((totalSec % 3600) / 60);
			const s = totalSec % 60;
			return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
		}

		setInterval(() => {
			if (isSessionRunning && activeSeconds > 0) {
				activeSeconds--;
				const formatted = formatTime(activeSeconds);
				if (countdownEl) countdownEl.textContent = `${formatted} remaining`;
				if (menubarTimeEl) menubarTimeEl.textContent = formatted;
			}
		}, 1000);

		// Preset Pills
		document.querySelectorAll('.preset-pill').forEach(pill => {
			pill.addEventListener('click', () => {
				document.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
				pill.classList.add('active');
				const t = pill.getAttribute('data-time');
				if (t === '15m') activeSeconds = 900;
				else if (t === '30m') activeSeconds = 1800;
				else if (t === '1h') activeSeconds = 3600;
				else if (t === '2h') activeSeconds = 7200;
				else if (t === '4h') activeSeconds = 14400;
				else if (t === 'unlimited') {
					activeSeconds = 999999;
					if (countdownEl) countdownEl.textContent = 'Indefinite Keep-Awake';
					if (menubarTimeEl) menubarTimeEl.textContent = '∞ Indefinite';
					return;
				}
				const formatted = formatTime(activeSeconds);
				if (countdownEl) countdownEl.textContent = `${formatted} remaining`;
				if (menubarTimeEl) menubarTimeEl.textContent = formatted;
			});
		});

		// Session Toggle Button
		const toggleSessionBtn = document.getElementById('btn-toggle-session');
		toggleSessionBtn?.addEventListener('click', () => {
			isSessionRunning = !isSessionRunning;
			if (isSessionRunning) {
				stateCard?.classList.remove('paused');
				heroMenubarStatus?.classList.add('active');
				if (heroBadge) {
					heroBadge.textContent = 'ACTIVE';
					heroBadge.className = 'badge-status-active';
				}
			} else {
				stateCard?.classList.add('paused');
				heroMenubarStatus?.classList.remove('active');
				if (heroBadge) {
					heroBadge.textContent = 'PAUSED';
					heroBadge.className = 'badge-status-paused';
				}
				if (countdownEl) countdownEl.textContent = 'Session paused';
				if (menubarTimeEl) menubarTimeEl.textContent = 'Paused';
			}
		});

		// Add 15m Button
		document.getElementById('btn-add-15')?.addEventListener('click', () => {
			activeSeconds += 900;
			const formatted = formatTime(activeSeconds);
			if (countdownEl) countdownEl.textContent = `${formatted} remaining`;
			if (menubarTimeEl) menubarTimeEl.textContent = formatted;
		});

		// Pause / Resume Button
		document.getElementById('btn-pause-resume')?.addEventListener('click', () => {
			toggleSessionBtn?.click();
		});

		// Stop Button
		document.getElementById('btn-stop-session')?.addEventListener('click', () => {
			isSessionRunning = false;
			activeSeconds = 0;
			stateCard?.classList.add('paused');
			heroMenubarStatus?.classList.remove('active');
			if (heroBadge) {
				heroBadge.textContent = 'STOPPED';
				heroBadge.className = 'badge-status-paused';
			}
			if (countdownEl) countdownEl.textContent = 'Session stopped';
			if (menubarTimeEl) menubarTimeEl.textContent = 'Idle';
		});

		// Copy CLI command button
		const copyBtn = document.getElementById('copy-cli-btn');
		copyBtn?.addEventListener('click', () => {
			navigator.clipboard.writeText('awake start 2h --clamshell').then(() => {
				copyBtn.textContent = 'Copied!';
				setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
			});
		});
	</script>
</Layout>

